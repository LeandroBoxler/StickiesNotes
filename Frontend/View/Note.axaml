<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="300"
        SystemDecorations="None"
        Background="Transparent"
        CanResize="True"
        x:Class="StickieNotes.View.Note"
        ShowInTaskbar="False"
        Topmost="False"
  
        >

    <Border Background="#ffffff"
            CornerRadius="12"
            Padding="2"
            >

        <Grid RowDefinitions="30,*">
            <Border Background="#FDD835"
                    CornerRadius="10,10,0,0"
                    PointerPressed="DragWindow">

                <Grid ColumnDefinitions="*,30">

                    <TextBlock Text="Note"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               FontWeight="Bold"
                               Background="#FDD835"
                               />

                    <Button Grid.Column="1"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="CloseWindow"/>

                </Grid>

            </Border>
            <TextBox Grid.Row="1"
                     Name="NoteContent"
                     AcceptsReturn="True"
                     Background="Transparent"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     Watermark="Write your note here..."/>

        </Grid>

    </Border>

</Window>